{
  "name": "it-tools",
  "type": "module",
  "version": "2026.10.18-ff54770",
  "desktopName": "it-tools",
  "main": "out/main/main.cjs",
  "engines": {
    "node": ">=24.0.0",
    "npm": "please-use-pnpm"
  },
  "packageManager": "pnpm@12.14.0",
  "description": "Collection of handy online tools for developers, with great UX. ",
  "author": "[likanug <likanug.g@qq.com>](https://likanug.top)",
  "authorUrl": "https://likanug.top",
  "sponsoringUrl": "https://buymeacoffee.com/bruceblink",
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "https://github.com/bruceblink/it-tools-template"
  },
  "keywords": [
    "productivity",
    "converter",
    "website",
    "vuejs",
    "tools",
    "frontend",
    "tool",
    "developer-tools",
    "developer-productivity"
  ],
  "scripts": {
    "dev": "pnpm generate:oui && vite",
    "build": "pnpm generate:oui && cross-env NODE_OPTIONS=--max_old_space_size=4096 vite build",
    "preview": "vite preview --port 5050",
    "test": "pnpm test:unit",
    "test:unit": "vitest --environment jsdom",
    "test:e2e": "playwright test",
    "test:e2e:dev": "cross-env BASE_URL=http://localhost:5173 NO_WEB_SERVER=true playwright test",
    "test:e2e:electron": "playwright test --config=playwright.electron.config.ts",
    "electron:dev": "pnpm generate:oui && electron-vite dev",
    "electron:build": "pnpm generate:oui && cross-env NODE_OPTIONS=--max_old_space_size=4096 electron-vite build",
    "electron:preview": "electron-vite preview",
    "electron:package:win": "pnpm electron:build && electron-builder --win nsis --publish never",
    "electron:package:linux": "pnpm electron:build && electron-builder --linux AppImage deb --publish never",
    "electron:package:mac": "pnpm electron:build && electron-builder --mac dmg zip --publish never",
    "coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit -p tsconfig.vite-config.json --composite false",
    "types:prepare": "node scripts/prepare-auto-imports.mjs",
    "typecheck:app": "pnpm types:prepare && vue-tsc --noEmit -p tsconfig.vitest.json --composite false",
    "typecheck:electron": "tsc --noEmit -p tsconfig.electron.json --composite false",
    "lint": "eslint \"src/**/*.{ts,tsx,vue}\" \"electron/**/*.{ts,tsx}\" \"electron-renderer/**/*.{ts,tsx}\" \"vite.config.ts\" \"electron.vite.config.ts\" \"vite.plugins.ts\" --max-warnings 0",
    "headers:sync": "node scripts/sync-security-headers.mjs",
    "headers:check": "node scripts/sync-security-headers.mjs --check && node --test scripts/sync-security-headers.test.mjs scripts/check-nginx-security-headers.test.mjs",
    "headers:docker": "node scripts/check-nginx-security-headers.mjs --dist-ready",
    "test:pwa:build": "node --test scripts/pwa-cache.test.mjs",
    "test:oui:build": "node --test scripts/generate-oui-data.test.mjs",
    "test:dependency-security": "node --test scripts/dependency-security.test.mjs",
    "test:heap-snapshot": "node --test scripts/heap-snapshot-analysis.test.mjs",
    "test:plugin-pack": "node --test scripts/plugin-pack.test.mjs",
    "generate:oui": "node scripts/generate-oui-data.mjs",
    "perf:baseline": "node scripts/performance-baseline.mjs",
    "test:performance-baseline": "node --test scripts/performance-baseline.test.mjs",
    "check": "pnpm headers:check && pnpm test:pwa:build && pnpm test:oui:build && pnpm test:dependency-security && pnpm test:heap-snapshot && pnpm test:plugin-pack && pnpm test:performance-baseline && pnpm test:tool-scaffold && pnpm typecheck && pnpm typecheck:electron && pnpm typecheck:app && pnpm lint --max-warnings 0 && pnpm test:unit --run && pnpm build && pnpm electron:build",
    "validate": "pnpm check",
    "script:create:tool": "node scripts/create-tool.mjs",
    "plugin:keygen": "node scripts/plugin-pack.mjs keygen",
    "plugin:pack": "node scripts/plugin-pack.mjs pack",
    "test:tool-scaffold": "node --test scripts/create-tool.test.mjs",
    "script:create:ui": "hygen generator ui-component",
    "release": "node ./scripts/release.mjs",
    "release:dry-run": "node ./scripts/release.mjs --dry-run"
  },
  "build": {
    "appId": "org.it-tools.desktop",
    "productName": "IT Tools",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "public/it-tools.ico"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Utility",
      "icon": "public/android-chrome-512x512.png",
      "syncDesktopName": true
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.developer-tools",
      "icon": "public/android-chrome-512x512.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "dependencies": {
    "@it-tools/bip39": "^0.0.4",
    "@it-tools/oggen": "^1.3.0",
