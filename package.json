{
  "name": "it-tools",
  "type": "module",
  "version": "2026.10.16-08de8e6",
  "desktopName": "it-tools",
  "main": "out/main/main.cjs",
  "engines": {
    "node": ">=22",
    "npm": "please-use-pnpm"
  },
  "packageManager": "pnpm@10.28.1",
  "description": "Collection of handy online tools for developers, with great UX. ",
  "author": "[likanug <likanug.g@qq.com>](https://likanug.top)",
  "authorUrl": "https://likanug.top",
  "sponsoringUrl": "https://buymeacoffee.com/bruceblink",
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "https://github.com/bruceblink/it-tools-template"
  },
  "keywords": [
    "productivity",
    "converter",
    "website",
    "vuejs",
    "tools",
    "frontend",
    "tool",
    "developer-tools",
    "developer-productivity"
  ],
  "scripts": {
    "dev": "vite",
    "build": "cross-env NODE_OPTIONS=--max_old_space_size=4096 vite build",
    "preview": "vite preview --port 5050",
    "test": "pnpm test:unit",
    "test:unit": "vitest --environment jsdom",
    "test:e2e": "playwright test",
    "test:e2e:dev": "cross-env BASE_URL=http://localhost:5173 NO_WEB_SERVER=true playwright test",
    "test:e2e:electron": "playwright test --config=playwright.electron.config.ts",
    "electron:dev": "electron-vite dev",
    "electron:build": "cross-env NODE_OPTIONS=--max_old_space_size=4096 electron-vite build",
    "electron:preview": "electron-vite preview",
    "electron:package:win": "pnpm electron:build && electron-builder --win nsis --publish never",
    "electron:package:linux": "pnpm electron:build && electron-builder --linux AppImage deb --publish never",
    "electron:package:mac": "pnpm electron:build && electron-builder --mac dmg zip --publish never",
    "coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit -p tsconfig.vite-config.json --composite false",
    "types:prepare": "node scripts/prepare-auto-imports.mjs",
    "typecheck:app": "pnpm types:prepare && vue-tsc --noEmit -p tsconfig.vitest.json --composite false",
    "typecheck:electron": "tsc --noEmit -p tsconfig.electron.json --composite false",
    "lint": "eslint \"src/**/*.{ts,tsx,vue}\" \"electron/**/*.{ts,tsx}\" \"electron-renderer/**/*.{ts,tsx}\" \"vite.config.ts\" \"electron.vite.config.ts\" \"vite.plugins.ts\" --max-warnings 0",
    "headers:sync": "node scripts/sync-security-headers.mjs",
    "headers:check": "node scripts/sync-security-headers.mjs --check && node --test scripts/sync-security-headers.test.mjs scripts/check-nginx-security-headers.test.mjs",
    "headers:docker": "node scripts/check-nginx-security-headers.mjs --dist-ready",
    "test:pwa:build": "node --test scripts/pwa-cache.test.mjs",
    "check": "pnpm headers:check && pnpm test:pwa:build && pnpm typecheck && pnpm typecheck:electron && pnpm typecheck:app && pnpm lint --max-warnings 0 && pnpm test:unit --run && pnpm build && pnpm electron:build",
    "validate": "pnpm check",
    "script:create:tool": "node scripts/create-tool.mjs",
    "script:create:ui": "hygen generator ui-component",
    "release": "node ./scripts/release.mjs",
    "release:dry-run": "node ./scripts/release.mjs --dry-run"
  },
  "build": {
    "appId": "org.it-tools.desktop",
    "productName": "IT Tools",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "public/it-tools.ico"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Utility",
      "icon": "public/android-chrome-512x512.png",
      "syncDesktopName": true
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.developer-tools",
      "icon": "public/android-chrome-512x512.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "pnpm": {
    "overrides": {
      "@types/node": "25.5.0"
    },
    "patchedDependencies": {
      "iarna-toml-esm@3.0.5": "patches/iarna-toml-esm@3.0.5.patch",
      "vuedraggable@4.1.0": "patches/vuedraggable@4.1.0.patch"
    },
    "onlyBuiltDependencies": [
      "@swc/core",
      "electron",
      "esbuild"
    ]
  },
  "dependencies": {
    "@it-tools/bip39": "^0.0.4",
    "@it-tools/oggen": "^1.3.0",
    "@regexper/render": "^1.0.0",
    "@sindresorhus/slugify": "^3.0.0",
    "@tabler/icons-vue": "^3.41.0",
    "@tiptap/pm": "3.21.0",
    "@tiptap/starter-kit": "3.21.0",
    "@tiptap/vue-3": "3.21.0",
    "@types/figlet": "^1.7.0",
    "@types/markdown-it": "^14.1.2",
    "@vicons/material": "^0.13.0",
    "@vicons/tabler": "^0.13.0",
    "@vueuse/core": "^14.2.1",
    "@vueuse/head": "^2.0.0",
    "@vueuse/router": "^14.2.1",
    "bcryptjs": "^3.0.3",
    "change-case": "^5.4.4",
    "colord": "^2.9.3",
    "composerize-ts": "^0.6.2",
    "country-code-lookup": "^0.1.5",
    "cron-validator": "^1.4.0",
    "cronstrue": "^3.14.0",
    "crypto-js": "^4.2.0",
    "date-fns": "^4.1.0",
    "dompurify": "^3.3.3",
    "email-normalizer": "^1.0.0",
    "emojilib": "^4.0.2",
    "figlet": "^1.11.0",
    "figue": "^3.2.0",
    "fuse.js": "^7.1.0",
    "highlight.js": "^11.11.1",
    "iarna-toml-esm": "^3.0.5",
    "ibantools": "^4.5.1",
    "js-base64": "^3.7.8",
    "json5": "^2.2.3",
    "jwt-decode": "^4.0.0",
    "libphonenumber-js": "^1.12.41",
    "lodash": "^4.17.23",
    "markdown-it": "^14.1.1",
    "marked": "^17.0.5",
    "mathjs": "^15.1.1",
    "mime-types": "^3.0.2",
    "monaco-editor": "^0.55.1",
    "naive-ui": "^2.44.1",
    "netmask": "^2.0.2",
    "node-forge": "^1.4.0",
    "oui-data": "^1.1.560",
    "pdf-signature-reader": "^1.4.3",
    "pinia": "^3.0.4",
    "plausible-tracker": "^0.3.9",
    "qrcode": "^1.5.4",
    "randexp": "^0.5.3",
    "sql-formatter": "^15.7.3",
    "ua-parser-js": "^2.0.9",
    "ulid": "^3.0.2",
    "unicode-emoji-json": "^0.8.0",
    "unplugin-auto-import": "^21.0.0",
    "unplugin-vue-markdown": "^29.2.0",
    "uuid": "^13.0.0",
    "valibot": "^1.3.1",
    "vue": "^3.5.31",
    "vue-i18n": "^11.3.0",
    "vue-router": "^4.6.4",
    "vue-shadow-dom": "^4.2.0",
    "vue-tsc": "^3.2.6",
    "vuedraggable": "^4.1.0",
    "xml-formatter": "^3.7.0",
    "xml-js": "^1.6.11",
    "yaml": "^2.8.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@iconify-json/mdi": "^1.2.3",
    "@intlify/unplugin-vue-i18n": "^11.0.7",
    "@playwright/test": "^1.58.2",
    "@swc/core": "^1.16.18",
    "@tsconfig/node18": "^18.2.6",
    "@types/crypto-js": "^4.2.2",
    "@types/jsdom": "^27.0.0",
    "@types/lodash": "^4.17.24",
    "@types/mime-types": "^3.0.1",
    "@types/netmask": "^2.0.6",
    "@types/node": "^25.5.0",
    "@types/node-forge": "^1.3.14",
    "@types/qrcode": "^1.5.6",
    "@types/ua-parser-js": "^0.7.39",
    "@typescript-eslint/eslint-plugin": "^8.57.2",
    "@typescript-eslint/parser": "^8.57.2",
    "@vitejs/plugin-vue": "^6.0.5",
    "@vitejs/plugin-vue-jsx": "^5.1.5",
    "@vue/compiler-sfc": "^3.5.31",
    "@vue/test-utils": "^2.4.6",
    "@vue/tsconfig": "^0.8.1",
    "consola": "^3.4.2",
    "cross-env": "^10.1.0",
    "electron": "44.8.0",
    "electron-builder": "26.15.3",
    "electron-vite": "6.0.0",
    "eslint": "^10.1.0",
    "eslint-plugin-vue": "^10.8.0",
    "hygen": "^6.2.11",
    "jsdom": "^27.4.0",
    "less": "^4.6.4",
    "prettier": "^3.8.1",
    "typescript": "~5.9.3",
    "unocss": "^66.6.7",
    "unocss-preset-scrollbar": "^3.2.0",
    "unplugin-icons": "^23.0.1",
    "unplugin-vue-components": "^31.1.0",
    "vite": "^7.3.1",
    "vite-plugin-pwa": "^1.2.0",
    "vite-svg-loader": "^5.1.1",
    "vitest": "^4.1.2",
    "vue-eslint-parser": "^10.4.0",
    "workbox-build": "^7.4.0",
    "workbox-core": "7.4.0",
    "workbox-expiration": "7.4.0",
    "workbox-precaching": "7.4.0",
    "workbox-routing": "7.4.0",
    "workbox-strategies": "7.4.0",
    "workbox-window": "^7.4.0",
    "zx": "^8.8.5"
  }
}
