{
  "extends": "./tsconfig.vite-config.json",
  "include": [
    "electron/**/*.ts",
    "electron-renderer/**/*.ts",
    "electron.vite.config.ts",
    "vite.plugins.ts",
    "src/app.ts",
    "src/shims.d.ts",
    "src/types/**/*.d.ts",
    "env.d.ts",
    "auto-imports.d.ts"
  ],
  "compilerOptions": {
    "composite": false,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "target": "ES2022",
    "types": ["node", "vitest", "unplugin-icons/types/vue"],
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "paths": {
      "@/*": ["./src/*"]
    }
  }
}
