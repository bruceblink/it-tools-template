+/**
+ * Encode a DigestInfo using canonical DER so verification can reject malformed
+ * encodings that the tolerant ASN.1 parser accepts.
+ */
+var _encodeDigestInfo = function(oid, digestBytes, withParams) {
+  var algorithmIdentifier = [asn1.create(
+    asn1.Class.UNIVERSAL, asn1.Type.OID, false,
+    asn1.oidToDer(oid).getBytes())];
+  if(withParams) {
+    algorithmIdentifier.push(asn1.create(
+      asn1.Class.UNIVERSAL, asn1.Type.NULL, false, ''));
+  }
+  var digestInfo = asn1.create(
+    asn1.Class.UNIVERSAL, asn1.Type.SEQUENCE, true, [
+      asn1.create(
+        asn1.Class.UNIVERSAL, asn1.Type.SEQUENCE, true, algorithmIdentifier),
+      asn1.create(
+        asn1.Class.UNIVERSAL, asn1.Type.OCTETSTRING, false, digestBytes)
+    ]);
+  return asn1.toDer(digestInfo).getBytes();
+};
+
 /**
  * Wrap digest in DigestInfo object.
  *
@@ -1208,6 +1230,18 @@ pki.setRsaPublicKey = pki.rsa.setPublicKey = function(n, e) {
             }
           }
 
+          // Match canonical encodings with and without NULL parameters. This
+          // rejects extra ASN.1 elements, nonempty NULL fields, and non-minimal
+          // lengths that would otherwise be ignored by the tolerant parser.
+          var expectedWithParams = _encodeDigestInfo(oid, capture.digest, true);
+          var expectedNoParams = _encodeDigestInfo(oid, capture.digest, false);
+          if(d.substring(0, expectedWithParams.length) !== expectedWithParams &&
+            d.substring(0, expectedNoParams.length) !== expectedNoParams) {
+            throw new Error(
+              'ASN.1 object does not contain a valid RSASSA-PKCS1-v1_5 ' +
+              'DigestInfo value.');
+          }
+
