{
  "extends": "@tsconfig/node24/tsconfig.json",
  "include": ["vite.config.*", "electron.vite.config.ts", "vite.plugins.ts"],
  "compilerOptions": {
    "composite": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": ["node", "vitest"],
    // allow importing JSON files like package.json from TS modules
    "resolveJsonModule": true,
    // enable interoperability when importing CommonJS defaults (pkg)
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true
  }
}
